---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';

const experience = [
  ['Master Thesis Intern · Ericsson', 'Stockholm · 2026 - Present'],
  ['Dog Walker · Tassevärld', 'Stockholm · 2025'],
  ['Software Developer · Kyri. Good Research (Startup Project)', 'Stockholm · 2025'],
  ['Unity Software Developer · Poznan University of Economics and Business', 'Poznan · 2023 - 2024'],
  ['Customer Service Specialist · Via Vox Group', 'Poznan · 2020 - 2022'],
  ['Event Assistant · Wielkopolski Związek Kajakowy', 'Poznan · 2020 - 2023'],
];

const education = [
  ['Stockholm University', 'Master’s Programme in AI for Health · 2024 - Present'],
  ['Poznan University of Economics and Business', 'Bachelor’s Programme in Informatics and Econometrics · 2021 - 2024'],
  ['PSI Poland', 'Java Course · 2023'],
];

const languages = [
  ['Polish', 'Native'],
  ['English', 'C1 (IELTS)'],
  ['Spanish', 'B1'],
  ['Swedish', 'A2'],
];

const programmingSkills = ['Java', 'C#', 'Python', 'SQL', 'Unity', 'JavaScript', 'TypeScript', 'React', 'CI/CD', 'Linux', '.NET', 'REST APIs', 'Full-Stack', 'Git', 'GitHub Actions', 'Bash', 'CSS3', 'Kotlin', 'YAML'];
const dataSkills = ['NumPy', 'Pandas', 'Matplotlib', 'PyTorch', 'Scikit-learn', 'R', 'Machine Learning', 'Data visualization', 'CNNs', 'Image processing', 'Semantic communication', 'Task-aware encoding'];

const splitMeta = (text) => text.split(' · ');
---

<BaseLayout title="Nikodem Kaczmarek — CV" description="CV of Nikodem Kaczmarek">
  <Fragment slot="nav">
    <Nav current="cv" />
  </Fragment>

  <header class="cv-header">
    <h1>Nikodem Kaczmarek</h1>
    <p class="headline">Artificial Intelligence Student & Intern</p>
    <p class="contact">
      <a class="text-link" href="mailto:me@nikodemkaczmarek.com">me@nikodemkaczmarek.com</a>
      <span class="place">Stockholm</span>
    </p>
  </header>

  <main class="cv">
    <section class="row" aria-labelledby="experience">
      <h2 class="row-label" id="experience">Experience</h2>
      <div class="row-body entries">
        {experience.map(([title, meta]) => (
          <article class="entry">
            <p class="entry-title">
              {splitMeta(title).map((part, i) => (
                <>{i > 0 && <span class="sep"> · </span>}<span class={i > 0 ? 'org' : undefined}>{part}</span></>
              ))}
            </p>
            <p class="meta">
              {splitMeta(meta).map((part, i) => (
                <>{i > 0 && <span class="sep"> · </span>}{part}</>
              ))}
            </p>
          </article>
        ))}
      </div>
    </section>

    <section class="row" aria-labelledby="education">
      <h2 class="row-label" id="education">Education</h2>
      <div class="row-body entries">
        {education.map(([title, meta]) => (
          <article class="entry">
            <p class="entry-title">{title}</p>
            <p class="meta">
              {splitMeta(meta).map((part, i) => (
                <>{i > 0 && <span class="sep"> · </span>}{part}</>
              ))}
            </p>
          </article>
        ))}
      </div>
    </section>

    <section class="row" aria-labelledby="languages">
      <h2 class="row-label" id="languages">Languages</h2>
      <div class="row-body languages">
        {languages.map(([language, level]) => (
          <div>
            <p class="entry-title">{language}</p>
            <p class="meta">{level}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="row" aria-labelledby="skills">
      <h2 class="row-label" id="skills">Skills</h2>
      <div class="row-body skill-groups">
        <div>
          <h3>Programming</h3>
          <ul class="tags">
            {programmingSkills.map((skill) => <li>{skill}</li>)}
          </ul>
        </div>
        <div>
          <h3>Data Science & Statistics</h3>
          <ul class="tags">
            {dataSkills.map((skill) => <li>{skill}</li>)}
          </ul>
        </div>
      </div>
    </section>

    <section class="row" aria-labelledby="certifications">
      <h2 class="row-label" id="certifications">Certifications</h2>
      <div class="row-body entries">
        <article class="entry">
          <p class="entry-title">AI Agents</p>
          <p class="meta">Hugging Face<span class="sep"> · </span>March 2025</p>
        </article>
        <article class="entry">
          <p class="entry-title">IELTS</p>
          <p class="meta">IELTS Official<span class="sep"> · </span>December 2023</p>
        </article>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .cv-header {
    padding: clamp(3rem, 9vw, 6rem) 0 2.5rem;
  }

  h1 {
    margin: 0;
    font-size: clamp(2.5rem, 6.4vw, 4.5rem);
    font-weight: 800;
    line-height: 0.95;
    letter-spacing: -0.04em;
  }

  .headline {
    margin-top: 0.9rem;
    font-size: clamp(1.125rem, 2vw, 1.3125rem);
    color: var(--muted);
  }

  .contact {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem 1.5rem;
    margin-top: 1.5rem;
    font-weight: 500;
  }

  .place { color: var(--muted); }

  .cv { padding-bottom: 4rem; }

  .entries {
    display: grid;
    gap: 1.25rem;
  }

  .entry-title {
    font-family: var(--serif);
    font-size: 1.1875rem;
    font-weight: 500;
    line-height: 1.35;
  }

  .entry-title .org { color: var(--muted); }

  .entry .meta { margin-top: 0.15rem; }

  .languages {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1.25rem 1.5rem;
  }

  .skill-groups {
    display: grid;
    gap: 1.75rem;
  }

  h3 {
    margin: 0 0 0.7rem;
    font-size: 1rem;
    font-weight: 600;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .tags li {
    padding: 0.2rem 0.6rem;
    border-radius: 4px;
    background: var(--tag);
    font-size: 0.875rem;
    line-height: 1.5;
  }

  @media (max-width: 720px) {
    .languages { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  @media print {
    .cv-header { padding: 0 0 1rem; }
    h1 { font-size: 26pt; }
    .tags li { border: 1px solid #ccc; background: none; }
  }
</style>

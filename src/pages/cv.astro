---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';

const experience = [
  ['Master Thesis Intern · Ericsson', 'Stockholm · 2026 - Present'],
  ['Dog Walker · Tassevärld', 'Stockholm · 2025'],
  ['Software Developer · Kyri. Good Research (Startup Project)', 'Stockholm · 2025'],
  ['Unity Software Developer · Poznan University of Economics and Business', 'Poznan · 2023 - 2024'],
  ['Customer Service Specialist · Via Vox Group', 'Poznan · 2020 - 2022'],
  ['Event Assistant · Wielkopolski Związek Kajakowy', 'Poznan · 2020 - 2023'],
];

const education = [
  ['Stockholm University', 'Master’s Programme in AI for Health · 2024 - Present'],
  ['Poznan University of Economics and Business', 'Bachelor’s Programme in Informatics and Econometrics · 2021 - 2024'],
  ['PSI Poland', 'Java Course · 2023'],
];

const languages = [
  ['Polish', 'Native'],
  ['English', 'C1 (IELTS)'],
  ['Spanish', 'B1'],
  ['Swedish', 'A2'],
];

const programmingSkills = ['Java', 'C#', 'Python', 'SQL', 'Unity', 'JavaScript', 'TypeScript', 'React', 'CI/CD', 'Linux', '.NET', 'REST APIs', 'Full-Stack', 'Git', 'GitHub Actions', 'Bash', 'CSS3', 'Kotlin', 'YAML'];
const dataSkills = ['NumPy', 'Pandas', 'Matplotlib', 'PyTorch', 'Scikit-learn', 'R', 'Machine Learning', 'Data visualization', 'CNNs', 'Image processing', 'Semantic communication', 'Task-aware encoding'];
---

<style>
  .cv-page .email-link {
    color: var(--ink);
    text-decoration: none;
  }

  .cv-page .email-link:hover {
    color: var(--accent);
  }

  .cv-page .tag-chip {
    color: #4f4741 !important;
    background: rgba(255, 250, 244, 0.9) !important;
    border-color: rgba(32, 24, 20, 0.12) !important;
  }

  .cv-page .keyword {
    color: #4f4741 !important;
    background: rgba(255, 250, 244, 0.9) !important;
  }

  .cv-page .cv-section {
    margin-bottom: 0.35rem !important;
    padding-top: 1.15rem !important;
    padding-bottom: 1.15rem !important;
  }

  .cv-page .entry + .entry {
    padding-top: 1rem;
  }

  .cv-page .entry-title {
    font-size: 0.95rem !important;
  }

  .cv-page .entry .text-secondary {
    font-size: 0.72rem !important;
  }

  .cv-page .cv-layout {
    row-gap: 0.35rem !important;
  }

  .cv-page .cv-main,
  .cv-page .cv-sidebar {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .cv-page .cv-main .cv-section,
  .cv-page .cv-sidebar .cv-section {
    margin-bottom: 0 !important;
  }

  .cv-page .cv-sidebar {
    position: sticky;
    top: 1rem;
    align-self: start;
  }

  .cv-page .language-list {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0;
  }

  .cv-page .language-item {
    padding: 0.2rem 1rem;
    border-left: 1px solid var(--border-soft);
  }

  .cv-page .language-item:first-child {
    padding-left: 0;
    border-left: 0;
  }

  @media (max-width: 576px) {
    .cv-page .language-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1rem 0;
    }

    .cv-page .language-item:nth-child(3) {
      padding-left: 0;
      border-left: 0;
    }
  }
</style>

<BaseLayout title="Nikodem Kaczmarek — CV" description="CV of Nikodem Kaczmarek" current="cv">
  <Fragment slot="nav">
    <Nav current="cv" />
  </Fragment>

  <div class="cv-page">
  <header class="hero-card rounded-5 p-4 p-md-5 mb-2">
    <h1 class="hero-title mb-2">Nikodem Kaczmarek</h1>
    <p class="headline mb-3">Artificial Intelligence Student & Intern</p>
    <div class="d-flex flex-wrap align-items-center gap-3">
      <a href="mailto:me@nikodemkaczmarek.com" class="email-link">
        me@nikodemkaczmarek.com
      </a>
      <span class="badge rounded-pill tag-chip fw-normal px-3 py-2">Stockholm</span>
    </div>
  </header>

  <div class="row g-4 cv-layout">
    <main class="col-lg-8 cv-main">
      <section class="section-card cv-section rounded-5 px-4 px-md-5">
        <div class="d-flex align-items-center gap-2 mb-4 section-title">
          <i class="bi bi-briefcase"></i>
          <span>Experience</span>
        </div>

        {experience.map(([title, meta]) => (
          <article class="entry">
            <p class="entry-title mb-1 fs-5">{title}</p>
            <p class="text-secondary small mb-0">{meta}</p>
          </article>
        ))}
      </section>

      <section class="section-card cv-section rounded-5 px-4 px-md-5">
        <div class="d-flex align-items-center gap-2 mb-4 section-title">
          <i class="bi bi-mortarboard"></i>
          <span>Education</span>
        </div>

        {education.map(([title, meta]) => (
          <article class="entry">
            <p class="entry-title mb-1 fs-5">{title}</p>
            <p class="text-secondary small mb-0">{meta}</p>
          </article>
        ))}
      </section>

      <section class="section-card cv-section rounded-5 px-4 px-md-5">
        <div class="d-flex align-items-center gap-2 mb-4 section-title">
          <i class="bi bi-translate"></i>
          <span>Languages</span>
        </div>

        <div class="language-list">
          {languages.map(([language, level]) => (
            <div class="language-item">
              <div class="entry-title fs-5 mb-1">{language}</div>
              <div class="text-secondary small">{level}</div>
            </div>
          ))}
        </div>
      </section>
    </main>

    <aside class="col-lg-4 cv-sidebar">
      <section class="section-card cv-section rounded-5 px-4 px-md-5 mb-2">
        <div class="d-flex align-items-center gap-2 mb-4 section-title">
          <i class="bi bi-tools"></i>
          <span>Skills</span>
        </div>

        <div class="mb-4">
          <p class="fw-semibold mb-2">Programming</p>
          <div class="d-flex flex-wrap gap-2">
            {programmingSkills.map((skill) => (
              <span class="badge rounded-pill keyword fw-normal px-3 py-2">{skill}</span>
            ))}
          </div>
        </div>

        <div>
          <p class="fw-semibold mb-2">Data Science & Statistics</p>
          <div class="d-flex flex-wrap gap-2">
            {dataSkills.map((skill) => (
              <span class="badge rounded-pill keyword fw-normal px-3 py-2">{skill}</span>
            ))}
          </div>
        </div>
      </section>

      <section class="section-card cv-section rounded-5 px-4 px-md-5">
        <div class="d-flex align-items-center gap-2 mb-4 section-title">
          <i class="bi bi-award"></i>
          <span>Certifications</span>
        </div>

        <article class="entry">
          <p class="entry-title mb-1 fs-5">AI Agents</p>
          <p class="text-secondary small mb-0">Hugging Face · March 2025</p>
        </article>
        <article class="entry mb-0">
          <p class="entry-title mb-1 fs-5">IELTS</p>
          <p class="text-secondary small mb-0">IELTS Official · December 2023</p>
        </article>
      </section>
    </aside>
  </div>
  </div>
</BaseLayout>

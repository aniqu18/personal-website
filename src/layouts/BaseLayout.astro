---
const {
  title,
  description,
  current = 'home',
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Zodiak:ital,wght@0,400;0,700;1,400&display=swap" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <style>
      :root {
        --bs-body-font-family: 'Inter', system-ui, sans-serif;
        --ink: #201814;
        --muted: #6f665d;
        --accent: #0d6efd;
        --surface: rgba(255, 250, 244, 0.82);
        --border-soft: rgba(32, 24, 20, 0.09);
      }

      html {
        scroll-behavior: smooth;
        background:
          radial-gradient(circle at top left, rgba(103, 86, 232, 0.12), transparent 30%),
          radial-gradient(circle at 85% 15%, rgba(199, 107, 86, 0.12), transparent 26%),
          linear-gradient(180deg, #f9f4ee 0%, #f3ede6 100%);
      }

      body {
        color: var(--ink);
        background: transparent;
        min-height: 100vh;
      }

      .page-shell {
        max-width: 1180px;
        margin: 0 auto;
        position: relative;
        z-index: 1;
      }

      .page-shell::before,
      .page-shell::after {
        content: "";
        position: fixed;
        inset: auto;
        pointer-events: none;
        border-radius: 999px;
        filter: blur(8px);
        z-index: -1;
      }

      .page-shell::before {
        width: 18rem;
        height: 18rem;
        top: 6rem;
        left: -5rem;
        background: radial-gradient(circle, rgba(103, 86, 232, 0.12), transparent 68%);
      }

      .page-shell::after {
        width: 20rem;
        height: 20rem;
        top: 26rem;
        right: -7rem;
        background: radial-gradient(circle, rgba(199, 107, 86, 0.12), transparent 68%);
      }

      .nav-pill,
      .hero-card,
      .section-card {
        background: var(--surface);
        border: 1px solid var(--border-soft);
        box-shadow: 0 18px 45px rgba(58, 42, 34, 0.08);
        backdrop-filter: blur(16px);
      }

      .hero-title,
      .section-title,
      .entry-title,
      .publication-title {
        font-family: 'Zodiak', Georgia, serif;
        letter-spacing: -0.03em;
      }

      .hero-title {
        font-size: clamp(3.7rem, 10vw, 7rem);
        line-height: 0.95;
      }

      .section-title {
        font-size: 0.78rem;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        color: var(--muted);
      }

      .headline {
        color: var(--muted);
        letter-spacing: 0.16em;
        text-transform: uppercase;
        font-size: 0.74rem;
      }

      .tag-chip {
        border: 1px solid rgba(32, 24, 20, 0.10);
        background: rgba(255, 250, 244, 0.76);
        color: var(--muted);
      }

      .accent-link {
        color: var(--accent);
        text-decoration: none;
      }

      .accent-link:hover { color: #0a58ca; }

      .entry + .entry {
        border-top: 1px solid rgba(32, 24, 20, 0.08);
        padding-top: 0.95rem;
      }

      .keyword {
        border: 1px solid rgba(32, 24, 20, 0.10);
        background: rgba(255, 250, 244, 0.78);
        color: var(--muted);
      }

      .summary-card {
        border: 1px solid var(--border-soft);
        background: rgba(255, 250, 244, 0.72);
      }

    </style>
  </head>
  <body>
    <div class="page-shell container px-1 px-md-2 py-3 py-md-4">
      <slot name="nav" />
      <slot />
    </div>
  </body>
</html>

---
// A line that starts as noise and settles into a clean carrier wave.
const width = 1200;
const height = 64;
const mid = height / 2;

let seed = 11;
const rand = () => {
  seed = (seed * 16807) % 2147483647;
  return seed / 2147483647 - 0.5;
};

const points = [];
for (let x = 0; x <= width; x += 3) {
  const t = x / width;
  const noise = rand() * height * 0.95 * Math.pow(1 - t, 2.2);
  const wave = Math.sin(x / 15) * height * 0.2 * Math.min(1, t * 2.5);
  points.push(`${x},${(mid + noise + wave).toFixed(1)}`);
}
---

<svg class="signal" viewBox={`0 0 ${width} ${height}`} preserveAspectRatio="none" aria-hidden="true" focusable="false">
  <polyline points={points.join(' ')} />
</svg>

<style>
  .signal {
    display: block;
    width: 100%;
    height: 3.25rem;
    overflow: visible;
  }

  polyline {
    fill: none;
    stroke: var(--accent);
    stroke-width: 1.6;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
  }

  @media (prefers-reduced-motion: no-preference) {
    .signal {
      animation: transmit 1.8s cubic-bezier(0.3, 0.6, 0.2, 1) 0.15s both;
    }
  }

  @keyframes transmit {
    from { clip-path: inset(0 100% 0 0); }
    to { clip-path: inset(0 0 0 0); }
  }
</style>
